[Unit]
Description=VoiceGuard API (/detect)
After=network-online.target
Wants=network-online.target

[Service]
User=voiceguard
WorkingDirectory=/opt/voiceguard/api
# API provisional: servidor de ejemplo de Altur. Cuando esté la API real, solo cambia esta línea.
ExecStart=/usr/bin/python3 /opt/voiceguard/api/example_server.py --host 127.0.0.1 --port 8000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
