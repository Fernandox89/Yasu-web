# VoiceGuard en Vultr: solo HTTP (puerto 80); página y API en el mismo servidor.
# Caddy no limita el tamaño del cuerpo, y las llamadas del juez pesan hasta ~12 MB en base64.
:80 {
	encode gzip

	# API
	handle /detect* {
		reverse_proxy 127.0.0.1:8000
	}

	handle /health {
		respond "ok" 200
	}

	# Página (sin publicar .git ni la carpeta deploy)
	handle {
		root * /opt/voiceguard/web
		file_server {
			hide .git deploy .gitignore
		}
	}
}
